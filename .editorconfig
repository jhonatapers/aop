root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 4
continuation_indent_size = 4
max_line_length = 120

[*.yml]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.yaml]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.json]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.properties]
indent_style = space
indent_size = 2

[*.xml]
indent_style = space
indent_size = 2

[*.gradle]
indent_size = 4

[*.gradle.kts]
indent_size = 4
